<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_recruitment_criteria_tree" model="ir.ui.view">
        <field name="name">hr.recruitment.criteria.list</field>
        <field name="model">hr.recruitment.criteria</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_active">
                <field name="name"/>
                <field name="job_id"/>
                <field name="benchmark_score" widget="integer"/>
                <field name="min_experience_years"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_recruitment_criteria_form" model="ir.ui.view">
        <field name="name">hr.recruitment.criteria.form</field>
        <field name="model">hr.recruitment.criteria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applicants" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="applicant_count" widget="statinfo" string="Applicants"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Criteria Profile Name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Target Config">
                            <field name="job_id"/>
                            <field name="benchmark_score" class="oe_inline"/>
                            <field name="min_experience_years"/>
                            <field name="is_active"/>
                        </group>
                        <group string="AI Evaluation Weights (%)">
                            <field name="skills_weight"/>
                            <field name="experience_weight"/>
                            <field name="education_weight"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Keyword Requirements" name="keywords">
                            <group>
                                <field name="keyword_required" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_recruitment_criteria" model="ir.actions.act_window">
        <field name="name">AI Recruitment Criteria</field>
        <field name="res_model">hr.recruitment.criteria</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_recruitment_criteria_config"
              name="AI Recruitment Criteria"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              action="action_hr_recruitment_criteria"
              sequence="1"/>
</odoo>