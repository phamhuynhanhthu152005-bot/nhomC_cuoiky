<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="training_list"
            model="ir.ui.view">

        <field name="name">training.list</field>

        <field name="model">training.plan</field>

        <field name="arch" type="xml">

            <list>

                <field name="employee"/>

                <field name="course_id"/>

                <field name="start_date"/>

                <field name="end_date"/>

                <field name="status"/>

            </list>

        </field>

    </record>


    <record id="training_form"
            model="ir.ui.view">

        <field name="name">training.form</field>

        <field name="model">training.plan</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="employee"/>

                        <field name="course_id"/>

                        <field name="start_date"/>

                        <field name="end_date"/>

                        <field name="status"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="training_action" model="ir.actions.act_window">

        <field name="name">Training Plan</field>
        <field name="res_model">training.plan</field>
        <field name="view_mode">list,form</field>
        
    </record>

</odoo>