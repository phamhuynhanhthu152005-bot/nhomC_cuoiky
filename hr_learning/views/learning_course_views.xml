<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         LEARNING COURSE – Course Recommendation
         FIX: Search view – field 'provider' là Char, searchable bình thường.
              Sửa widget float_time: chỉ hợp lệ cho field lưu giờ:phút (HH:MM).
              duration là Float (số giờ thực), dùng widget mặc định hoặc không khai báo.
         ============================================================ -->

    <!-- List View -->
    <record id="view_learning_course_list" model="ir.ui.view">
        <field name="name">learning.course.list</field>
        <field name="model">learning.course</field>
        <field name="arch" type="xml">
            <list string="Course Recommendation">
                <field name="name" string="Course Name"/>
                <field name="job_position_id" string="Job Position"/>
                <field name="provider"/>
                <field name="duration" string="Duration (hours)"/>
                <button
                    name="action_create_training_plan"
                    string="Create Training Plan"
                    type="object"
                    icon="fa-plus-circle"
                    class="btn-success"
                />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_learning_course_form" model="ir.ui.view">
        <field name="name">learning.course.form</field>
        <field name="model">learning.course</field>
        <field name="arch" type="xml">
            <form string="Learning Course">
                <header>
                    <button
                        name="action_create_training_plan"
                        string="Create Training Plan"
                        type="object"
                        class="btn-success"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Course Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Course Details">
                            <field name="job_position_id"/>
                            <field name="provider"/>
                            <field name="duration" string="Duration (hours)"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Course description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <!-- FIX: Cú pháp Odoo 19 – không cần filter_domain cho Char field,
         Odoo tự ilike. Many2one field dùng domain search mặc định. -->
    <record id="view_learning_course_search" model="ir.ui.view">
    <field name="name">learning.course.search</field>
    <field name="model">learning.course</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="job_position_id"/>
        </search>
    </field>
    </record>

    <!-- Window Action -->
    <record id="action_learning_course" model="ir.actions.act_window">
        <field name="name">Course Recommendation</field>
        <field name="res_model">learning.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_learning_course_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No courses found. Create your first learning course!
            </p>
            <p>
                Each course is linked to a Job Position and will appear
                as a recommendation for employees in that role.
            </p>
        </field>
    </record>

</odoo>
