<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="skill_list" model="ir.ui.view">
        <field name="name">skill.list</field>
        <field name="model">skill.master</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_position"/>
            </list>
        </field>

    </record>


    <record id="skill_form" model="ir.ui.view">
        <field name="name">skill.form</field>
        <field name="model">skill.master</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="job_position"/>
                    </group>

                </sheet>

            </form>
        </field>

    </record>


    <record id="skill_action" model="ir.actions.act_window">

        <field name="name">Job Search</field>

        <field name="res_model">skill.master</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>