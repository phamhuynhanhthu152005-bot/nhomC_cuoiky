<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_attendance_penalty_form" model="ir.ui.view">
        <field name="name">hr.attendance.penalty.summary.form</field>
        <field name="model">hr.attendance.penalty.summary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,pushed"/>
                    <button name="action_confirm"
                            string="Xac nhan"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hr_attendance_control.group_attendance_manager"/>
                    <button name="action_push_to_payroll"
                            string="Day vao Payroll"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"
                            groups="hr_attendance_control.group_attendance_admin"
                            confirm="Thao tac nay se tao khoan khau tru trong phieu luong. Tiep tuc?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="penalty_display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thong tin">
                            <field name="employee_id" readonly="1"/>
                            <field name="month" readonly="1"/>
                            <field name="year" readonly="1"/>
                            <field name="payslip_id" readonly="1"/>
                        </group>
                        <group string="Thong ke vi pham">
                            <field name="total_violations" readonly="1"/>
                            <field name="minor_count" readonly="1"/>
                            <field name="moderate_count" readonly="1"/>
                            <field name="major_count" readonly="1"/>
                            <field name="absence_days" readonly="1"/>
                            <field name="late_minutes_total" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ket qua tai chinh">
                        <group>
                            <field name="total_points" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_deduction" string="Tong khau tru (VND)" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiet vi pham">
                            <field name="violation_ids" readonly="1">
                                <list decoration-danger="severity == 'major'"
                                      decoration-warning="severity == 'moderate'">
                                    <field name="date"/>
                                    <field name="violation_type"/>
                                    <field name="deviation_minutes" string="Phut vi pham"/>
                                    <field name="severity"/>
                                    <field name="penalty_points"/>
                                    <field name="penalty_amount" string="Tien phat (VND)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_penalty_list" model="ir.ui.view">
        <field name="name">hr.attendance.penalty.summary.list</field>
        <field name="model">hr.attendance.penalty.summary</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'pushed'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="total_violations == 0">
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_violations"/>
                <field name="absence_days"/>
                <field name="total_points"/>
                <field name="total_deduction" string="Tong khau tru (VND)"/>
                <field name="state"/>
                <field name="pushed_to_payroll" widget="boolean"/>
                <button name="action_confirm" type="object" icon="fa-check"
                        invisible="state != 'draft'"
                        groups="hr_attendance_control.group_attendance_manager"/>
                <button name="action_push_to_payroll" type="object" icon="fa-send"
                        invisible="state != 'confirmed'"
                        groups="hr_attendance_control.group_attendance_admin"/>
            </list>
        </field>
    </record>

    <record id="action_hr_attendance_penalty_summary" model="ir.actions.act_window">
        <field name="name">Tong hop khau tru vi pham</field>
        <field name="res_model">hr.attendance.penalty.summary</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>