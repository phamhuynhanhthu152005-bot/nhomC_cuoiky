<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_attendance_control" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.control</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_violations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-circle"
                        invisible="violation_count == 0"
                        groups="hr_attendance_control.group_attendance_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="violation_count"/>
                        </span>
                        <span class="o_stat_text">Vi pham</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Vi pham cham cong"
                      name="attendance_violations"
                      groups="hr_attendance_control.group_attendance_user">
                    <group col="3">
                        <field name="violation_count"
                               string="Tong vi pham" readonly="1"/>
                        <field name="pending_violation_count"
                               string="Cho xu ly" readonly="1"/>
                        <field name="current_month_points"
                               string="Diem thang nay" readonly="1"/>
                    </group>
                    <field name="violation_ids" nolabel="1">
                        <list decoration-danger="severity == 'major' and state not in ('waived','penalized')"
                              decoration-warning="severity == 'moderate' and state not in ('waived','penalized')"
                              decoration-muted="state in ('waived','penalized')">
                            <field name="date"/>
                            <field name="violation_type"/>
                            <field name="deviation_minutes" string="Phut"/>
                            <field name="severity"/>
                            <field name="state"/>
                            <field name="penalty_amount" string="Phat (VND)"/>
                            <field name="is_escalated" widget="boolean"/>
                            <button name="action_confirm" type="object"
                                    icon="fa-check"
                                    invisible="state not in ('detected','explained','pending_explanation')"
                                    groups="hr_attendance_control.group_attendance_manager"/>
                            <button name="action_waive" type="object"
                                    icon="fa-ban"
                                    invisible="state not in ('detected','explained','pending_explanation')"
                                    groups="hr_attendance_control.group_attendance_manager"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>