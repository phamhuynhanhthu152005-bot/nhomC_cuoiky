<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_attendance_rule_form" model="ir.ui.view">
        <field name="name">hr.attendance.rule.form</field>
        <field name="model">hr.attendance.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Di muon nhe (5-15 phut)"/></h1>
                    </div>
                    <group>
                        <group string="Dieu kien kich hoat">
                            <field name="violation_type"/>
                            <field name="threshold_minutes" string="Nguong toi thieu (phut)"/>
                            <field name="threshold_minutes_max" string="Nguong toi da (phut)"/>
                            <field name="grace_period_minutes"/>
                        </group>
                        <group string="Muc do va Diem phat">
                            <field name="severity"/>
                            <field name="penalty_points"/>
                            <field name="penalty_type"/>
                            <field name="penalty_value"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Pham vi ap dung">
                        <group>
                            <field name="department_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="job_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Cau hinh giai trinh">
                        <field name="requires_explanation"/>
                        <field name="explanation_deadline_hours"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_rule_list" model="ir.ui.view">
        <field name="name">hr.attendance.rule.list</field>
        <field name="model">hr.attendance.rule</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_active == False">
                <field name="name"/>
                <field name="violation_type"/>
                <field name="threshold_minutes" string="Nguong (phut)"/>
                <field name="threshold_minutes_max" string="Toi da (phut)"/>
                <field name="severity"/>
                <field name="penalty_points"/>
                <field name="penalty_type"/>
                <field name="penalty_value"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_attendance_rule" model="ir.actions.act_window">
        <field name="name">Cau hinh Rule vi pham</field>
        <field name="res_model">hr.attendance.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>